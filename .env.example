# ============================================================
# GenAI DocQA Platform — Environment Variables Template
# ============================================================
# HOW TO USE:
#   cp .env.example .env
#   Then fill in your real values in .env
#
# NEVER commit .env to git — only .env.example is committed
# Generate secrets with: openssl rand -hex 32
# ============================================================


# ============================================================
# DATABASE
# ============================================================
# Driver MUST be postgresql+asyncpg:// — not postgresql://
# Using postgresql:// will break async SQLAlchemy silently
# For Docker Compose: docker-compose.yml overrides this with
# postgres (service name) instead of localhost automatically
DATABASE_URL=postgresql+asyncpg://docqa:docqa_password@localhost:5432/docqa


# ============================================================
# REDIS
# ============================================================
# /0 = database index 0 (Redis supports 0-15)
# Used for: rate limiting, query cache, embedding cache, sessions
REDIS_URL=redis://localhost:6379/0


# ============================================================
# SECURITY — NEVER share these values
# ============================================================
# Generate with: openssl rand -hex 32
# Must be at least 32 characters — app refuses to start otherwise

# Signs JWT tokens — if stolen, attacker can forge login tokens
SECRET_KEY=replace-with-64-char-hex-string-generate-with-openssl-rand-hex-32

# AES-256-GCM encryption key for LLM API keys stored in DB
ENCRYPTION_KEY=replace-with-another-64-char-hex-string-generate-with-openssl-rand-hex-32

# Access token: short-lived (15 min) — limits damage if stolen
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token: long-lived — used to silently get new access token
REFRESH_TOKEN_EXPIRE_DAYS=7


# ============================================================
# APPLICATION
# ============================================================
# Set to "development" locally, "production" in deployment
ENVIRONMENT=development

# Enable debug mode in development only — NEVER in production
DEBUG=true

# Backend server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Allowed origins for CORS (frontend URL)
# In production: replace with your actual frontend domain
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# ============================================================
# LLM PROVIDERS
# ============================================================
# Groq is our DEFAULT — free tier, no credit card needed
# Get your free key at: https://console.groq.com
# Free tier: 14,400 requests/day — enough for full development
GROQ_API_KEY=your-groq-api-key-here

# Optional providers — leave empty if not using
# These are stored encrypted in DB when users add via UI (BYOK)
# But for system-level calls, we read from env vars
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# Default LLM provider and model for the system
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.1-8b-instant


# ============================================================
# EMBEDDINGS
# ============================================================
# local = Sentence-Transformers (free, runs on CPU, no API key)
# openai = text-embedding-3-small (paid, $0.02/1M tokens)
# cohere = embed-english-v3.0 (free tier: 1000 calls/month)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2


# ============================================================
# FILE STORAGE
# ============================================================
# local = store on server disk (development only)
# r2    = Cloudflare R2 (production — free: 10GB, 1M req/month)
STORAGE_BACKEND=local

# Local storage path (used when STORAGE_BACKEND=local)
UPLOAD_DIR=uploads

# Max file size per upload (in MB)
MAX_FILE_SIZE_MB=50

# Cloudflare R2 settings (only needed when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=


# ============================================================
# OBSERVABILITY
# ============================================================
# LangSmith — traces every LangGraph agent run automatically
# Get free key at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=genai-docqa

# Prometheus metrics endpoint (exposed at /metrics)
PROMETHEUS_ENABLED=true


# ============================================================
# RATE LIMITING
# ============================================================
# Requests per minute per user per endpoint
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20


# ============================================================
# ADMIN (default admin user created on first startup)
# ============================================================
# Change these immediately after first login
ADMIN_EMAIL=admin@docqa.local
ADMIN_PASSWORD=admin123!
